# =============================================================================
# AstroLumina Environment Variables — PRODUCTION
# Copy as .env and fill in the values. Template: development/.env.example
# Blue-green: the LIVE color is switched in traefik/dynamic/routes.yml,
# not via .env.
# TRAEFIK_DASHBOARD_AUTH: generated with `htpasswd -nb admin PASSWORD`
# example: admin:$apr1$xxxx$yyyy (keep the quotes in .env)
# =============================================================================
NODE_ENV=production
GITHUB_TOKEN=...
GITHUB_USER=...
# echo $GITHUB_TOKEN | docker login ghcr.io -u $GITHUB_USER --password-stdin
# Image tags live in versions.env (tracked in git) — see that file.
TRAEFIK_DASHBOARD_AUTH=...
# ─────────────────────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_SERVER_PORT=...
FRONTEND_SENTRY_DSN=...
REVOLUT_PAY_PUBLIC_KEY=...
      REVOLUT_PAY_API_VERSION=...
R2_BASE_URL=...
# ─────────────────────────────────────────────────────────────────────────────
# AstrologyAPI
# ─────────────────────────────────────────────────────────────────────────────
ASTROLOGY_API_SERVER_PORT=...
ASTROLOGY_API_SENTRY_DSN=...
ASTROLOGER_API_URL=...
ASTROLOGER_API_HOST=...
ASTROLOGER_API_KEY=...
# ─────────────────────────────────────────────────────────────────────────────
# BookingAPI (R2_BASE_URL is shared — defined once in the Frontend section)
# ─────────────────────────────────────────────────────────────────────────────
BOOKING_API_SERVER_PORT=...
BOOKING_API_SENTRY_DSN=...
CALCOM_BASE_URL=...
CALCOM_API_KEY=...
RESEND_API_KEY=...
D1_ACCOUNT_ID=...
D1_DATABASE_ID=...
D1_API_TOKEN=...
# ─────────────────────────────────────────────────────────────────────────────
# PaymentAPI
# ─────────────────────────────────────────────────────────────────────────────
PAYMENT_API_SERVER_PORT=...
PAYMENT_API_SENTRY_DSN=...
REVOLUT_PAY_API_VERSION=...
REVOLUT_PAY_SECRET_KEY=...
# ─────────────────────────────────────────────────────────────────────────────
# Shared DC/K8S endpoint pairs (used by every service to build CORS origins
# and reach the other services; kept last by convention)
# ─────────────────────────────────────────────────────────────────────────────
ASTROLOGY_API_SERVER_DC_PORT=...
ASTROLOGY_API_SERVER_DC_DNS=...
ASTROLOGY_API_SERVER_K8S_PORT=...
ASTROLOGY_API_SERVER_K8S_DNS=...
BOOKING_API_SERVER_DC_PORT=...
BOOKING_API_SERVER_DC_DNS=...
BOOKING_API_SERVER_K8S_PORT=...
BOOKING_API_SERVER_K8S_DNS=...
PAYMENT_API_SERVER_DC_PORT=...
PAYMENT_API_SERVER_DC_DNS=...
PAYMENT_API_SERVER_K8S_PORT=...
PAYMENT_API_SERVER_K8S_DNS=...
FRONTEND_SERVER_DC_PORT=...
FRONTEND_SERVER_DC_DNS=...
FRONTEND_SERVER_K8S_PORT=...
FRONTEND_SERVER_K8S_DNS=...
# ─────────────────────────────────────────────────────────────────────────────
# Container-level API URLs (consumed by the frontend container).
# In Compose these take the _API_DC_URL values above
# (docker-compose maps ASTROLOGY_API_URL=${ASTROLOGY_API_DC_URL}, and so on).
# ─────────────────────────────────────────────────────────────────────────────
ASTROLOGY_API_URL=...
PAYMENT_API_URL=...
BOOKING_API_URL=...
# ─────────────────────────────────────────────────────────────────────────────
